/*
Module: l298_driver
Updated to include speed_offset inputs for dynamic alignment.
Base duty cycle is 90% (900/1000).
Offsets reduce the duty cycle of the specific motor to steer.
*/

module l298_driver (
    input wire clk,          // 50 MHz
    input wire [1:0] l_ctrl, // {fwd, rev} from move_controller
    input wire [1:0] r_ctrl, // {fwd, rev} from move_controller
    input wire [7:0] speed_offset_l, // Reduction for left motor
    input wire [7:0] speed_offset_r, // Reduction for right motor
    output reg [3:0] l298_in, // {L_fwd, L_rev, R_fwd, R_rev}
    output wire ena,
    output wire enb
);

    assign ena = 1'b1;
    assign enb = 1'b1;

    reg [9:0] pwm_cnt;
    always @(posedge clk) begin
        if (pwm_cnt >= 999) pwm_cnt <= 0;
        else pwm_cnt <= pwm_cnt + 1;
    end

    // Dynamic thresholds based on 90% base (900) minus alignment offset
    wire [9:0] l_threshold = 900 - {2'b00, speed_offset_l};
    wire [9:0] r_threshold = 900 - {2'b00, speed_offset_r};

    wire l_pwm_sig = (pwm_cnt < l_threshold);
    wire r_pwm_sig = (pwm_cnt < r_threshold);

    always @(*) begin
        // Left Motor modulated by its specific threshold
        l298_in[3] = l_ctrl[1] & l_pwm_sig; 
        l298_in[2] = l_ctrl[0] & l_pwm_sig; 
        
        // Right Motor modulated by its specific threshold
        l298_in[1] = r_ctrl[1] & r_pwm_sig; 
        l298_in[0] = r_ctrl[0] & r_pwm_sig; 
    end

endmodule